# Local development defaults. Copy to .env (scripts/dev-setup.mjs does this for you).
# These values are for the docker-compose services only. Never put real secrets here.

# If a port is already taken on your machine, change it here; docker-compose reads this file.
POSTGRES_USER=labconnect
POSTGRES_PASSWORD=labconnect
POSTGRES_DB=labconnect
POSTGRES_PORT=5432
REDIS_PORT=6379
OPENSEARCH_PORT=9200
LOCALSTACK_PORT=4566
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Application settings (keep in step with the ports above).
# DATABASE_URL is the owner: migrations and seeds only. The API and the worker connect as
# their own users, which are subject to row-level security (pnpm db:local-users creates them).
DATABASE_URL=postgresql://labconnect:labconnect@localhost:5432/labconnect
API_DATABASE_URL=postgresql://labconnect_api:labconnect_api@localhost:5432/labconnect
WORKER_DATABASE_URL=postgresql://labconnect_worker:labconnect_worker@localhost:5432/labconnect
REDIS_URL=redis://localhost:6379
OPENSEARCH_URL=http://localhost:9200
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SMTP_HOST=localhost
SMTP_PORT=1025

# apps/api listens here; apps/web uses Next.js default 3000.
PORT=3001

# apps/api, identity (docs/04-api/AUTHENTICATION_AND_AUTHORISATION.md, "As built (P3-03)").
# The sign-in code is sent through SMTP_HOST and SMTP_PORT above (Mailpit, UI on port 8025).
# The three secrets below are read when first used, so the API starts without them but cannot
# sign anyone in. Generate your own for each environment; never commit a real value.
#   AUTH_JWT_PRIVATE_KEY, an Ed25519 key (PKCS#8 PEM; write its newlines as \n on one line):
#     node -e "console.log(require('node:crypto').generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'pem'}).trim().split(String.fromCharCode(10)).join(String.fromCharCode(92)+'n'))"
#   AUTH_HASH_SECRET, the key of the OTP and recovery-code HMACs (32 or more random bytes, base64):
#     node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
#   AUTH_ENCRYPTION_KEY, AES-256-GCM key for TOTP secrets (exactly 32 random bytes, base64; the
#     same command). Local and test only: deployed environments use KMS (task P3-11).
# AUTH_JWT_PRIVATE_KEY=
# AUTH_HASH_SECRET=
# AUTH_ENCRYPTION_KEY=
# While a signing key is being replaced, the old public key (SPKI PEM) keeps verifying:
# AUTH_JWT_KEY_ID=k1
# AUTH_JWT_PREVIOUS_PUBLIC_KEY=
# AUTH_JWT_PREVIOUS_KEY_ID=
# AUTH_JWT_ISSUER=labconnect-api
# AUTH_JWT_AUDIENCE=labconnect
# Origins (comma separated) that may call POST /v1/auth/refresh. None are allowed if unset.
AUTH_ALLOWED_ORIGINS=http://localhost:3000
# Sender of the sign-in email.
# MAIL_FROM=LabConnect <no-reply@labconnect.local>
# Behind a load balancer: how many proxies to trust for the client address (X-Forwarded-For).
# Without this every request seems to come from the balancer, and the per-IP OTP limit (20 per
# hour) would apply to everyone at once. Leave unset when the API is reached directly.
# API_TRUST_PROXY_HOPS=1

# pnpm seed:platform-admin creates the first platform administrator from these two.
# PLATFORM_ADMIN_EMAIL=
# PLATFORM_ADMIN_NAME=

# apps/worker: queue URLs for the outbox relay (QUEUE_URL_<QUEUE NAME IN CAPITALS, other characters as _>),
# and optional polling settings. With WORKER_DATABASE_URL set the worker runs the outbox relay,
# audit sealing, the timer pass and nightly audit verification. AWS_ENDPOINT_URL above points the SDK at LocalStack.
# QUEUE_URL_LC_NOTIFICATIONS_FIFO=http://localhost:4566/000000000000/lc-notifications.fifo
# QUEUE_URL_LC_ANALYTICS=http://localhost:4566/000000000000/lc-analytics
# OUTBOX_RELAY_INTERVAL_MS=1000
# OUTBOX_RELAY_BATCH_SIZE=100
# AUDIT_SEAL_INTERVAL_MS=10000
# AUDIT_SEAL_BATCH_SIZE=500
# AUDIT_VERIFY_INTERVAL_MS=86400000
# Timers: how often the worker looks for due timers, and the most it fires per pass (P3-02).
# TIMER_POLL_INTERVAL_MS=15000
# TIMER_BATCH_SIZE=50

# Files (P3-06, docs/05-integrations/FILES_AND_REPORTS.md "As built (P3-06)").
# apps/api and apps/worker read these when files are first used, so both start without them.
# One bucket, two prefixes: uploads land under the quarantine prefix, validated files are promoted to the clean prefix.
# FILES_BUCKET=labconnect-files
# FILES_QUARANTINE_PREFIX=quarantine
# FILES_CLEAN_PREFIX=clean
# S3 settings (credentials and region come from AWS_ACCESS_KEY_ID / AWS_REGION above, or the task role):
# FILES_S3_ENDPOINT=http://localhost:4566
# FILES_S3_FORCE_PATH_STYLE=true          # LocalStack needs path-style URLs
# FILES_S3_SSE_KMS=false                  # local emulators only: no SSE-KMS header on the clean copy
# FILES_KMS_KEY_ID=                       # SSE-KMS key of the clean copy; the bucket default if unset
# Worker: consume scan results from this queue (the files job needs it, WORKER_DATABASE_URL and FILES_BUCKET).
# QUEUE_URL_LC_FILES=http://localhost:4566/000000000000/lc-files
# FILES_POLL_INTERVAL_MS=2000
# FILES_POLL_BATCH_SIZE=10
# Local development only: the worker scans PENDING uploads with a FAKE scanner (no GuardDuty yet, OQ-116).
# Refused unless NODE_ENV is development or test, so also export NODE_ENV=development for the worker.
# FILES_DEV_AUTO_SCAN=true
# NODE_ENV=development


# Payments (docs/05-integrations/PAYMENTS_AND_LEDGER.md, "As built (P3-09)").
# No real gateway adapter exists (OQ-01): PAYMENT_GATEWAY must be "fake". The API and the worker
# refuse to start for any other value, and for the fake in production (APP_ENV=production, or
# NODE_ENV=production without APP_ENV=uat). Unset means "fake" where it is allowed.
# PAYMENT_GATEWAY=fake
# APP_ENV=local
# The fake gateway's own HMAC key (16 or more characters; it protects nothing real). Read on first use.
# PAYMENT_FAKE_WEBHOOK_SECRET=dev-only-fake-gateway-secret
# AES-256-GCM key for stored gateway notifications (exactly 32 random bytes, base64; same command as
# AUTH_ENCRYPTION_KEY). The API and the worker need the same value. Local and test only: deployed
# environments use KMS (task P3-11).
# PAYMENT_PAYLOAD_ENCRYPTION_KEY=
# apps/worker: how often stored gateway notifications are processed, and the most per pass.
# PAYMENT_EVENTS_POLL_INTERVAL_MS=2000
# PAYMENT_EVENTS_BATCH_SIZE=25
