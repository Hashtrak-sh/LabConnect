# Local development defaults. Copy to .env (scripts/dev-setup.mjs does this for you).
# These values are for the docker-compose services only. Never put real secrets here.

# If a port is already taken on your machine, change it here; docker-compose reads this file.
POSTGRES_USER=labconnect
POSTGRES_PASSWORD=labconnect
POSTGRES_DB=labconnect
POSTGRES_PORT=5432
REDIS_PORT=6379
OPENSEARCH_PORT=9200
LOCALSTACK_PORT=4566
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Application settings (keep in step with the ports above).
# DATABASE_URL is the owner: migrations and seeds only. The API and the worker connect as
# their own users, which are subject to row-level security (pnpm db:local-users creates them).
DATABASE_URL=postgresql://labconnect:labconnect@localhost:5432/labconnect
API_DATABASE_URL=postgresql://labconnect_api:labconnect_api@localhost:5432/labconnect
WORKER_DATABASE_URL=postgresql://labconnect_worker:labconnect_worker@localhost:5432/labconnect
REDIS_URL=redis://localhost:6379
OPENSEARCH_URL=http://localhost:9200
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SMTP_HOST=localhost
SMTP_PORT=1025

# apps/api listens here; apps/web uses Next.js default 3000.
PORT=3001

# pnpm seed:platform-admin creates the first platform administrator from these two.
# PLATFORM_ADMIN_EMAIL=
# PLATFORM_ADMIN_NAME=

# apps/worker: queue URLs for the outbox relay (QUEUE_URL_<QUEUE NAME IN CAPITALS, other characters as _>),
# and optional polling settings. With WORKER_DATABASE_URL set the worker runs the outbox relay,
# audit sealing, the timer pass and nightly audit verification. AWS_ENDPOINT_URL above points the SDK at LocalStack.
# QUEUE_URL_LC_NOTIFICATIONS_FIFO=http://localhost:4566/000000000000/lc-notifications.fifo
# QUEUE_URL_LC_ANALYTICS=http://localhost:4566/000000000000/lc-analytics
# OUTBOX_RELAY_INTERVAL_MS=1000
# OUTBOX_RELAY_BATCH_SIZE=100
# AUDIT_SEAL_INTERVAL_MS=10000
# AUDIT_SEAL_BATCH_SIZE=500
# AUDIT_VERIFY_INTERVAL_MS=86400000
# Timers: how often the worker looks for due timers, and the most it fires per pass (P3-02).
# TIMER_POLL_INTERVAL_MS=15000
# TIMER_BATCH_SIZE=50
