# Keep the build context small and free of anything that must not enter an image.
**/node_modules
**/dist
**/.next
**/.turbo
**/coverage
**/cdk.out
.git
.github
.claude
docs
tests

# Workspaces the images do not use. Their package.json stays so that pnpm's lockfile still
# matches the workspace; their code does not enter the build.
infrastructure/*
!infrastructure/package.json
!infrastructure/scripts
apps/web/*
!apps/web/package.json

# Local configuration and secrets: never in an image (deployed environments use Secrets Manager).
.env
.env.*
!.env.example
**/*.log
**/*.pem
**/*.key

# Generated by the build, not copied in
packages/database/src/generated
packages/api-contract/src/generated
