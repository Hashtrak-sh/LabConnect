# Keep the build context small and free of anything that must not enter an image.
**/node_modules
**/dist
**/.next
**/.turbo
**/coverage
**/cdk.out
.git
.github
.claude
docs
tests

# The infrastructure workspace is not part of any image. Its package.json stays so that pnpm's
# lockfile still matches the workspace; its code does not enter the build.
infrastructure/*
!infrastructure/package.json
!infrastructure/scripts

# Local configuration and secrets: never in an image (deployed environments use Secrets Manager).
.env
.env.*
!.env.example
**/*.log
**/*.pem
**/*.key

# Generated by the build, not copied in
packages/database/src/generated
packages/api-contract/src/generated

# The single-server kit: its .env, gate password and database backups live in deploy/ec2/.
# Nothing in deploy/ belongs in an image.
deploy/
