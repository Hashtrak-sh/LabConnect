// 2. Identity

model Organisation {
  id String @id @db.Uuid
  orgType OrgType @map("org_type")
  customerSegment CustomerSegment? @map("customer_segment")
  legalName String @map("legal_name")
  displayName String @map("display_name")
  gstin String? @db.VarChar(15)
  registeredAddress Json? @map("registered_address")
  claimStatus ClaimStatus @map("claim_status")
  kycStatus VerificationStatus @default(NOT_STARTED) @map("kyc_status")
  status OrgStatus @default(ACTIVE)
  nablLabRef String? @map("nabl_lab_ref") @db.VarChar(50)
  currentVersionNo Int @default(1) @map("current_version_no")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdByUserId String? @map("created_by_user_id") @db.Uuid
  lockVersion Int @default(0) @map("lock_version")

  createdByUser AppUser? @relation("organisation_created_by_user_id", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  memberships Membership[] @relation("membership_organisation_id")
  invitations Invitation[] @relation("invitation_organisation_id")
  organisationPrivates OrganisationPrivate[] @relation("organisation_private_organisation_id")
  organisationVersions OrganisationVersion[] @relation("organisation_version_organisation_id")
  fileObjectsAsOwnerOrg FileObject[] @relation("file_object_owner_org_id")
  fileObjectsAsCustomerOrg FileObject[] @relation("file_object_customer_org_id")
  fileObjectsAsLabOrg FileObject[] @relation("file_object_lab_org_id")
  mdChangeSets MdChangeSet[] @relation("md_change_set_proposed_by_org_id")
  importMappingTemplates ImportMappingTemplate[] @relation("import_mapping_template_owner_org_id")
  importJobs ImportJob[] @relation("import_job_organisation_id")
  labSites LabSite[] @relation("lab_site_organisation_id")
  labClaimRequests LabClaimRequest[] @relation("lab_claim_request_organisation_id")
  kycDocuments KycDocument[] @relation("kyc_document_organisation_id")
  bankAccounts BankAccount[] @relation("bank_account_organisation_id")
  labPenalties LabPenalty[] @relation("lab_penalty_lab_org_id")
  customerSites CustomerSite[] @relation("customer_site_organisation_id")
  customerSettingses CustomerSettings[] @relation("customer_settings_organisation_id")
  bookings Booking[] @relation("booking_customer_org_id")
  payouts Payout[] @relation("payout_lab_org_id")
  ledgerAccounts LedgerAccount[] @relation("ledger_account_party_org_id")
  documentSerieses DocumentSeries[] @relation("document_series_issuer_org_id")
  financialDocumentsAsIssuerOrg FinancialDocument[] @relation("financial_document_issuer_org_id")
  financialDocumentsAsRecipientOrg FinancialDocument[] @relation("financial_document_recipient_org_id")
  notifications Notification[] @relation("notification_organisation_id")

  @@unique([orgType, gstin])
  @@index([orgType, status])
  @@map("organisation")
}

