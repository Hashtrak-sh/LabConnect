model Membership {
  id String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  organisationId String @map("organisation_id") @db.Uuid
  status MembershipStatus
  activatedAt DateTime? @map("activated_at") @db.Timestamptz(6)
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(6)
  deactivatedByUserId String? @map("deactivated_by_user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdByUserId String? @map("created_by_user_id") @db.Uuid
  lockVersion Int @default(0) @map("lock_version")

  user AppUser @relation("membership_user_id", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  organisation Organisation @relation("membership_organisation_id", fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  deactivatedByUser AppUser? @relation("membership_deactivated_by_user_id", fields: [deactivatedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdByUser AppUser? @relation("membership_created_by_user_id", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  membershipRoles MembershipRole[] @relation("membership_role_membership_id")
  membershipSites MembershipSite[] @relation("membership_site_membership_id")
  userSessions UserSession[] @relation("user_session_active_membership_id_user_id")

  @@unique([userId, organisationId])
  @@unique([id, userId])
  @@index([organisationId, status])
  @@map("membership")
}

model MembershipRole {
  id String @id @db.Uuid
  membershipId String @map("membership_id") @db.Uuid
  role RoleCode
  grantedByUserId String? @map("granted_by_user_id") @db.Uuid
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdByUserId String? @map("created_by_user_id") @db.Uuid

  membership Membership @relation("membership_role_membership_id", fields: [membershipId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  grantedByUser AppUser? @relation("membership_role_granted_by_user_id", fields: [grantedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdByUser AppUser? @relation("membership_role_created_by_user_id", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([membershipId, role], map: "uq_membership_role_active", where: { revokedAt: null })
  @@unique([membershipId], map: "uq_membership_role_one_lab_role", where: raw("((role = ANY (ARRAY['LAB_MAKER'::role_code, 'LAB_CHECKER'::role_code])) AND (revoked_at IS NULL))"))
  @@map("membership_role")
}

model MembershipSite {
  id String @id @db.Uuid
  membershipId String @map("membership_id") @db.Uuid
  labSiteId String @map("lab_site_id") @db.Uuid
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdByUserId String? @map("created_by_user_id") @db.Uuid

  membership Membership @relation("membership_site_membership_id", fields: [membershipId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  labSite LabSite @relation("membership_site_lab_site_id", fields: [labSiteId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdByUser AppUser? @relation("membership_site_created_by_user_id", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([membershipId, labSiteId], map: "uq_membership_site_active", where: { revokedAt: null })
  @@index([labSiteId], map: "ix_membership_site_site_active", where: { revokedAt: null })
  @@map("membership_site")
}

model Invitation {
  id String @id @db.Uuid
  organisationId String @map("organisation_id") @db.Uuid
  email String @db.Citext
  roles RoleCode[]
  tokenHash Bytes @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdByUserId String? @map("created_by_user_id") @db.Uuid

  organisation Organisation @relation("invitation_organisation_id", fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdByUser AppUser? @relation("invitation_created_by_user_id", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  invitationSites InvitationSite[] @relation("invitation_site_invitation_id")

  @@unique([tokenHash])
  @@index([organisationId, email])
  @@map("invitation")
}

model OtpChallenge {
  id String @id @db.Uuid
  channel OtpChannel
  destinationHash Bytes @map("destination_hash")
  purpose OtpPurpose
  codeHash Bytes @map("code_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  attempts Int @default(0)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  contextId String? @map("context_id") @db.Uuid
  ipAddress String? @map("ip_address") @db.Inet
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdByUserId String? @map("created_by_user_id") @db.Uuid

  createdByUser AppUser? @relation("otp_challenge_created_by_user_id", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([destinationHash, purpose, createdAt])
  @@map("otp_challenge")
}

model MfaFactor {
  id String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  factorType MfaFactorType @map("factor_type")
  secretCiphertext Bytes @map("secret_ciphertext")
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastUsedStep BigInt? @map("last_used_step")
  failedAttempts Int @default(0) @map("failed_attempts")
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdByUserId String? @map("created_by_user_id") @db.Uuid

  user AppUser @relation("mfa_factor_user_id", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdByUser AppUser? @relation("mfa_factor_created_by_user_id", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([userId, factorType], map: "uq_mfa_factor_active", where: { verifiedAt: { not: null }, revokedAt: null })
  @@map("mfa_factor")
}

model MfaRecoveryCode {
  id String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  codeHash Bytes @map("code_hash")
  usedAt DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdByUserId String? @map("created_by_user_id") @db.Uuid

  user AppUser @relation("mfa_recovery_code_user_id", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdByUser AppUser? @relation("mfa_recovery_code_created_by_user_id", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId])
  @@map("mfa_recovery_code")
}

model UserSession {
  id String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  activeMembershipId String? @map("active_membership_id") @db.Uuid
  refreshTokenHash Bytes @map("refresh_token_hash")
  tokenFamilyId String @map("token_family_id") @db.Uuid
  mfaVerifiedAt DateTime? @map("mfa_verified_at") @db.Timestamptz(6)
  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent")
  deviceLabel String? @map("device_label")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason String? @map("revoked_reason") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdByUserId String? @map("created_by_user_id") @db.Uuid

  user AppUser @relation("user_session_user_id", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdByUser AppUser? @relation("user_session_created_by_user_id", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  activeMembership Membership? @relation("user_session_active_membership_id_user_id", fields: [activeMembershipId, userId], references: [id, userId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([refreshTokenHash])
  @@index([tokenFamilyId])
  @@index([userId], map: "ix_user_session_user_live", where: { revokedAt: null })
  @@map("user_session")
}

