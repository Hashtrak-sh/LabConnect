// 5. Labs

model LabSite {
  id String @id @db.Uuid
  organisationId String @map("organisation_id") @db.Uuid
  siteCode String @map("site_code") @db.VarChar(30)
  name String
  address Json
  pincode String @db.Char(6)
  stateCode String @map("state_code") @db.VarChar(4)
  geoPoint Unsupported("geography(Point,4326)")? @map("geo_point")
  geocodeConfidence Decimal? @map("geocode_confidence") @db.Decimal(4, 3)
  geocodeStatus GeocodeStatus @default(PENDING) @map("geocode_status")
  submissionInstructions String? @map("submission_instructions")
  maxOpenJobs Int? @map("max_open_jobs")
  listingStatus ListingStatus @default(LISTED) @map("listing_status")
  isBookable Boolean @default(false) @map("is_bookable")
  bookabilityReasons String[] @default([]) @map("bookability_reasons")
  ratingAvg Decimal? @map("rating_avg") @db.Decimal(3, 2)
  ratingCount Int @default(0) @map("rating_count")
  responsivenessScore Decimal? @map("responsiveness_score") @db.Decimal(5, 2)
  status MdStatus @default(ACTIVE)
  currentVersionNo Int @default(1) @map("current_version_no")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdByUserId String? @map("created_by_user_id") @db.Uuid
  lockVersion Int @default(0) @map("lock_version")

  organisation Organisation @relation("lab_site_organisation_id", fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdByUser AppUser? @relation("lab_site_created_by_user_id", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  membershipSites MembershipSite[] @relation("membership_site_lab_site_id")
  invitationSites InvitationSite[] @relation("invitation_site_lab_site_id")
  importJobs ImportJob[] @relation("import_job_lab_site_id")
  labSiteVersions LabSiteVersion[] @relation("lab_site_version_lab_site_id")
  accreditations Accreditation[] @relation("accreditation_lab_site_id_organisation_id")
  scopeLines ScopeLine[] @relation("scope_line_lab_site_id_organisation_id")
  labClaimRequests LabClaimRequest[] @relation("lab_claim_request_lab_site_id")
  bankAccounts BankAccount[] @relation("bank_account_lab_site_id")
  receivingHourses ReceivingHours[] @relation("receiving_hours_lab_site_id_organisation_id")
  siteClosures SiteClosure[] @relation("site_closure_lab_site_id_organisation_id")
  retentionRules RetentionRule[] @relation("retention_rule_lab_site_id_organisation_id")
  priceLists PriceList[] @relation("price_list_lab_site_id_organisation_id")
  slotTemplates SlotTemplate[] @relation("slot_template_lab_site_id_organisation_id")
  slots Slot[] @relation("slot_lab_site_id_organisation_id")
  labSitePrivates LabSitePrivate[] @relation("lab_site_private_lab_site_id_organisation_id")
  labPenalties LabPenalty[] @relation("lab_penalty_lab_site_id")
  leadRequests LeadRequest[] @relation("lead_request_lab_site_id")
  bookings Booking[] @relation("booking_lab_site_id_lab_org_id")
  custodyEvents CustodyEvent[] @relation("custody_event_lab_site_id")
  reports Report[] @relation("report_lab_site_id")

  @@unique([siteCode])
  @@unique([id, organisationId])
  @@index([isBookable, listingStatus])
  @@index([organisationId])
  @@index([pincode])
  @@index([geoPoint], type: Gist)
  @@map("lab_site")
}

model LabSiteVersion {
  id String @id @db.Uuid
  labSiteId String @map("lab_site_id") @db.Uuid
  versionNo Int @map("version_no")
