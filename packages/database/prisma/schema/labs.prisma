model ScopeLine {
  id String @id @db.Uuid
  organisationId String @map("organisation_id") @db.Uuid
  labSiteId String @map("lab_site_id") @db.Uuid
  accreditationId String @map("accreditation_id") @db.Uuid
  disciplineNodeId String @map("discipline_node_id") @db.Uuid
  groupNodeId String? @map("group_node_id") @db.Uuid
  productNodeId String? @map("product_node_id") @db.Uuid
  parameterNodeId String @map("parameter_node_id") @db.Uuid
  methodNodeId String? @map("method_node_id") @db.Uuid
  methodText String? @map("method_text")
  rangeText String? @map("range_text")
