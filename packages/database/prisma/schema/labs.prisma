  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdByUserId String? @map("created_by_user_id") @db.Uuid
  lockVersion Int @default(0) @map("lock_version")

  disciplineNode MdNode @relation("scope_line_discipline_node_id", fields: [disciplineNodeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  groupNode MdNode? @relation("scope_line_group_node_id", fields: [groupNodeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  productNode MdNode? @relation("scope_line_product_node_id", fields: [productNodeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  parameterNode MdNode @relation("scope_line_parameter_node_id", fields: [parameterNodeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  methodNode MdNode? @relation("scope_line_method_node_id", fields: [methodNodeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rangeUnitNode MdNode? @relation("scope_line_range_unit_node_id", fields: [rangeUnitNodeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdByUser AppUser? @relation("scope_line_created_by_user_id", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  labSite LabSite @relation("scope_line_lab_site_id_organisation_id", fields: [labSiteId, organisationId], references: [id, organisationId], onDelete: Restrict, onUpdate: Restrict)
  accreditation Accreditation @relation("scope_line_accreditation_id_lab_site_id", fields: [accreditationId, labSiteId], references: [id, labSiteId], onDelete: Restrict, onUpdate: Restrict)
  scopeLineVersions ScopeLineVersion[] @relation("scope_line_version_scope_line_id")
  priceItems PriceItem[] @relation("price_item_scope_line_id")
  bookingLines BookingLine[] @relation("booking_line_scope_line_id")

  @@unique([labSiteId, naturalKeyHash], map: "uq_scope_line_natural_key_active", where: { status: "ACTIVE" })
  @@unique([id, labSiteId])
  @@index([labSiteId, status])
  @@index([parameterNodeId, status])
  @@index([productNodeId])
  @@index([disciplineNodeId])
  @@index([methodNodeId])
  @@map("scope_line")
}

