  authorisationFile FileObject? @relation("lab_claim_request_authorisation_file_id", fields: [authorisationFileId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reviewedByUser AppUser? @relation("lab_claim_request_reviewed_by_user_id", fields: [reviewedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdByUser AppUser? @relation("lab_claim_request_created_by_user_id", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organisationId], map: "uq_lab_claim_request_pending", where: raw("(status = ANY (ARRAY['PENDING_OTP'::claim_request_status, 'PENDING_REVIEW'::claim_request_status]))"))
  @@index([organisationId, status])
  @@map("lab_claim_request")
}

