  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdByUserId String? @map("created_by_user_id") @db.Uuid
  lockVersion Int @default(0) @map("lock_version")

  accreditationBody AccreditationBody @relation("accreditation_accreditation_body_id", fields: [accreditationBodyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  standard AccreditationStandard @relation("accreditation_standard_id", fields: [standardId], references: [id], onDelete: Restrict, onUpdate: Restrict)
