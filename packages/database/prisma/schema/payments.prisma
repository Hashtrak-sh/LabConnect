// 10. Payments and finance

model PaymentOrder {
  id String @id @db.Uuid
  bookingId String @map("booking_id") @db.Uuid
  customerOrgId String @map("customer_org_id") @db.Uuid
  labOrgId String @map("lab_org_id") @db.Uuid
  attemptNo Int @map("attempt_no")
  idempotencyKey String @map("idempotency_key") @db.VarChar(100)
  gateway GatewayCode
  gatewayOrderRef String? @map("gateway_order_ref") @db.VarChar(100)
  amountPaise BigInt @map("amount_paise")
  status PaymentOrderStatus @default(CREATED)
  initiatedByUserId String @map("initiated_by_user_id") @db.Uuid
  checkoutExpiresAt DateTime? @map("checkout_expires_at") @db.Timestamptz(6)
  reconcileUntil DateTime? @map("reconcile_until") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdByUserId String? @map("created_by_user_id") @db.Uuid
  lockVersion Int @default(0) @map("lock_version")

  initiatedByUser AppUser @relation("payment_order_initiated_by_user_id", fields: [initiatedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdByUser AppUser? @relation("payment_order_created_by_user_id", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  booking Booking @relation("payment_order_booking_id_customer_org_id_lab_org_id", fields: [bookingId, customerOrgId, labOrgId], references: [id, customerOrgId, labOrgId], onDelete: Restrict, onUpdate: Restrict)
  paymentTransactions PaymentTransaction[] @relation("payment_transaction_payment_order_id_customer_org_id_lab_org_id")
  refunds Refund[] @relation("refund_payment_order_id")

  @@unique([idempotencyKey])
  @@unique([bookingId, attemptNo])
  @@unique([gateway, gatewayOrderRef])
  @@unique([id, customerOrgId, labOrgId])
  @@unique([bookingId], map: "uq_payment_order_captured", where: raw("(status = ANY (ARRAY['CAPTURED'::payment_order_status, 'REFUNDED_PARTIAL'::payment_order_status, 'REFUNDED_FULL'::payment_order_status]))"))
  @@index([status, reconcileUntil], map: "ix_payment_order_pending", where: { status: "PENDING" })
  @@map("payment_order")
}

model PaymentTransaction {
  id String @id @db.Uuid
  customerOrgId String @map("customer_org_id") @db.Uuid
  labOrgId String @map("lab_org_id") @db.Uuid
  paymentOrderId String @map("payment_order_id") @db.Uuid
  gateway GatewayCode
  gatewayTxnRef String @map("gateway_txn_ref") @db.VarChar(100)
  txnType PaymentTxnType @map("txn_type")
  method String? @db.VarChar(30)
  amountPaise BigInt @map("amount_paise")
  status PaymentTxnStatus
  isDuplicate Boolean @default(false) @map("is_duplicate")
  gatewayReportedAt DateTime? @map("gateway_reported_at") @db.Timestamptz(6)
  webhookEventId String? @map("webhook_event_id") @db.Uuid
  rawSummary Json? @map("raw_summary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdByUserId String? @map("created_by_user_id") @db.Uuid

  webhookEvent GatewayWebhookEvent? @relation("payment_transaction_webhook_event_id", fields: [webhookEventId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdByUser AppUser? @relation("payment_transaction_created_by_user_id", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  paymentOrder PaymentOrder @relation("payment_transaction_payment_order_id_customer_org_id_lab_org_id", fields: [paymentOrderId, customerOrgId, labOrgId], references: [id, customerOrgId, labOrgId], onDelete: Restrict, onUpdate: Restrict)
  ledgerJournals LedgerJournal[] @relation("ledger_journal_payment_transaction_id")
  settlementReportLines SettlementReportLine[] @relation("settlement_report_line_matched_transaction_id")

  @@unique([gateway, gatewayTxnRef, txnType])
  @@index([paymentOrderId])
  @@map("payment_transaction")
}

model GatewayWebhookEvent {
  id String @id @db.Uuid
  gateway GatewayCode
  eventId String @map("event_id") @db.VarChar(100)
  eventType String @map("event_type") @db.VarChar(60)
  signatureValid Boolean @map("signature_valid")
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  payloadCiphertext Bytes @map("payload_ciphertext")
  payloadSha256 Bytes @map("payload_sha256")
  processingStatus WebhookProcessingStatus @default(RECEIVED) @map("processing_status")
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  error String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  paymentTransactions PaymentTransaction[] @relation("payment_transaction_webhook_event_id")

  @@unique([gateway, eventId])
  @@index([receivedAt], map: "ix_gateway_webhook_event_unprocessed", where: raw("(processing_status = ANY (ARRAY['RECEIVED'::webhook_processing_status, 'FAILED'::webhook_processing_status]))"))
  @@map("gateway_webhook_event")
}

model Refund {
  id String @id @db.Uuid
  bookingId String @map("booking_id") @db.Uuid
  customerOrgId String @map("customer_org_id") @db.Uuid
  labOrgId String @map("lab_org_id") @db.Uuid
  paymentOrderId String @map("payment_order_id") @db.Uuid
  amountPaise BigInt @map("amount_paise")
  reasonCodeNodeId String @map("reason_code_node_id") @db.Uuid
  policyRule String? @map("policy_rule") @db.VarChar(10)
  initiatedByParty PartyType @map("initiated_by_party")
  initiatedByUserId String? @map("initiated_by_user_id") @db.Uuid
  approvedByUserId String? @map("approved_by_user_id") @db.Uuid
  status RefundStatus @default(REQUESTED)
  gatewayRefundRef String? @map("gateway_refund_ref") @db.VarChar(100)
