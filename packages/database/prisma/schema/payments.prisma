  disputeId String? @map("dispute_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdByUserId String? @map("created_by_user_id") @db.Uuid
  lockVersion Int @default(0) @map("lock_version")

  paymentOrder PaymentOrder @relation("refund_payment_order_id", fields: [paymentOrderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reasonCodeNode MdNode @relation("refund_reason_code_node_id", fields: [reasonCodeNodeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  initiatedByUser AppUser? @relation("refund_initiated_by_user_id", fields: [initiatedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approvedByUser AppUser? @relation("refund_approved_by_user_id", fields: [approvedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creditNote FinancialDocument? @relation("refund_credit_note_id", fields: [creditNoteId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  dispute Dispute? @relation("refund_dispute_id", fields: [disputeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdByUser AppUser? @relation("refund_created_by_user_id", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  booking Booking @relation("refund_booking_id_customer_org_id_lab_org_id", fields: [bookingId, customerOrgId, labOrgId], references: [id, customerOrgId, labOrgId], onDelete: Restrict, onUpdate: Restrict)
  ledgerJournals LedgerJournal[] @relation("ledger_journal_refund_id")

  @@index([bookingId])
  @@index([paymentOrderId])
  @@index([status])
  @@map("refund")
}

model Payout {
  id String @id @db.Uuid
  labOrgId String @map("lab_org_id") @db.Uuid
  bankAccountId String @map("bank_account_id") @db.Uuid
  amountPaise BigInt @map("amount_paise")
  status PayoutStatus @default(PENDING)
  mechanism PayoutMechanism @default(TBD)
  eligibleAt DateTime? @map("eligible_at") @db.Timestamptz(6)
  releasedByUserId String? @map("released_by_user_id") @db.Uuid
  releasedAt DateTime? @map("released_at") @db.Timestamptz(6)
  externalRef String? @map("external_ref") @db.VarChar(100)
  failureReason String? @map("failure_reason")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdByUserId String? @map("created_by_user_id") @db.Uuid
  lockVersion Int @default(0) @map("lock_version")

  labOrg Organisation @relation("payout_lab_org_id", fields: [labOrgId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  releasedByUser AppUser? @relation("payout_released_by_user_id", fields: [releasedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdByUser AppUser? @relation("payout_created_by_user_id", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
