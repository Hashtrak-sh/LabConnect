  payoutItems PayoutItem[] @relation("payout_item_payout_id")
  ledgerJournals LedgerJournal[] @relation("ledger_journal_payout_id")

  @@index([labOrgId, status])
  @@index([status, eligibleAt])
  @@map("payout")
}

