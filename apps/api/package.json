{
  "name": "@labconnect/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project http",
    "test:integration": "vitest run --project http-db",
    "test:contract": "vitest run --project http --project http-db --project contract-final",
    "test:permissions": "vitest run --project http --project permissions-db test/permissions/ test/integration/permissions/ test/admin-roles-permissions",
    "test:isolation": "vitest run --project http --project isolation-db test/isolation/ test/integration/isolation/",
    "contract:update-not-implemented": "vitest run --mode update-not-implemented --project http test/contract/endpoints.spec.ts"
  },
  "dependencies": {
    "@labconnect/core": "workspace:*",
    "@labconnect/database": "workspace:*",
    "@labconnect/shared": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "^12.6.0",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@labconnect/api-contract": "workspace:*",
    "@labconnect/config": "workspace:*",
    "@nestjs/cli": "^12.0.15",
    "@nestjs/testing": "catalog:",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "supertest": "^7.3.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
